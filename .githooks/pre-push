#!/bin/sh
# Local guardrail only. GitHub API and other clones are not protected by this hook.
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = refs/heads/main ]; then
    echo 'Direct pushes/deletions of main are blocked locally. Push a branch and use a PR.' >&2
    exit 1
  fi
done
